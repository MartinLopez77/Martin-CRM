{
  // Comprobación de tipos del JavaScript con JSDoc (no genera archivos: la app no se compila).
  // src/legacy.js (el código aún sin migrar) lleva @ts-nocheck hasta que desaparezca.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "server.js", "demo.mjs", "tests/**/*.mjs", "playwright.config.mjs", "eslint.config.mjs"]
}
